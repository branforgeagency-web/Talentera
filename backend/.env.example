# Copy this file to backend/.env and fill in real values before running the
# server. Every variable below is read somewhere in backend/ - this file
# previously didn't exist even though both READMEs told people to copy it,
# so the only way to find these names was to grep backend/.env directly.
# See IMPROVEMENT_ROADMAP.md "No backend/.env.example."

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://localhost:27017/talentera

# --- Auth ---
# Required. Server refuses to start without this (backend/middleware/auth.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of additional allowed frontend origins, beyond the
# built-in localhost + *.vercel.app defaults (backend/server.js).
CLIENT_ORIGINS=

# --- Uploads ---
MAX_UPLOAD_SIZE=52428800

# --- Encryption (optional) ---
# Only needed if you use backend/utils/encryption.js for a field that must
# be encrypted at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=info

# --- Brevo (transactional email: OTP codes, password reset, application
#     lifecycle emails) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@talentera.in
BREVO_SENDER_NAME=Talentera Verification
BREVO_SMS_SENDER=TALENT

# --- Cloudinary (optional - falls back to local disk /uploads if unset) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MSG91 (login OTP widget + SMS OTP) ---
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# --- Aadhaar verification gateway ---
AADHAAR_PROVIDER=sandbox
AADHAAR_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

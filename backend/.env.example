# Copy this file to backend/.env and fill in real values before running the
# server. Every variable below is read somewhere in backend/ - this file
# previously didn't exist even though both READMEs told people to copy it,
# so the only way to find these names was to grep backend/.env directly.
# See IMPROVEMENT_ROADMAP.md "No backend/.env.example."

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://localhost:27017/talentera

# --- Auth ---
# Required. Server refuses to start without this (backend/middleware/auth.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of additional allowed frontend origins, beyond the
# built-in localhost + *.vercel.app defaults (backend/server.js).
CLIENT_ORIGINS=

# --- App URL ---
# The frontend origin used to build links sent in emails - currently just
# the student invite email's "Activate my profile" link
# (backend/routes/academy.js sendInviteEmail). Falls back to
# https://talentera.in if unset.
APP_URL=https://talentera.in

# --- Uploads ---
MAX_UPLOAD_SIZE=52428800

# --- Encryption (optional) ---
# Only needed if you use backend/utils/encryption.js for a field that must
# be encrypted at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=info

# --- Brevo (transactional email: OTP codes, password reset, application
#     lifecycle emails) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@talentera.in
BREVO_SENDER_NAME=Talentera Verification
BREVO_SMS_SENDER=TALENT

# --- Cloudinary (optional - falls back to local disk /uploads if unset) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MSG91 (login OTP widget + SMS OTP) ---
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# --- Aadhaar & Identity Verification Gateway ---
# Provider options: messagecentral | cashfree | sandbox | surepass
AADHAAR_PROVIDER=cashfree
AADHAAR_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# Message Central (eKYCNow) Aadhaar DigiLocker Gateway
# Register at https://ekyc.messagecentral.com
MESSAGECENTRAL_API_KEY=
CUSTOMER_ID=
MESSAGECENTRAL_REDIRECT_URL=

# Cashfree Verification Suite (Aadhaar OKYC, PAN, GSTIN, Bank Penny Drop)
# Register at https://www.cashfree.com/verification-suite/
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2024-01-01

# --- Vapi (voice AI for the Stage 5 AI Mock Interview "Messi") ---
# Get both keys from your Vapi Dashboard -> API Keys.
# VAPI_PRIVATE_KEY: used server-side only, to create the assistant via
# scripts/setupVapiAssistant.js (node scripts/setupVapiAssistant.js from
# backend/, one-time). Never expose this one to the frontend.
VAPI_PRIVATE_KEY=
# VAPI_PUBLIC_KEY: safe to also expose to the frontend as
# VITE_VAPI_PUBLIC_KEY (see frontend/.env.example) - Vapi's public keys are
# scoped for browser use.
VAPI_PUBLIC_KEY=
# Auto-written by scripts/setupVapiAssistant.js after it creates the
# assistant - you shouldn't need to set this by hand. Also copy the same
# value into frontend/.env as VITE_VAPI_ASSISTANT_ID.
VAPI_ASSISTANT_ID=
# Optional override for scripts/setupVapiAssistant.js - only needed if
# you're pointing the assistant at a tunnel (e.g. ngrok) for local testing
# instead of the deployed backend. Must be a publicly reachable HTTPS URL;
# Vapi's servers call it directly, so localhost will not work.
VAPI_LLM_URL=

# --- Browserbase (live, human-operated remote browser sessions for Stage 3
#     Certification Document Audit Queue "Live Verify" - staff drives a
#     real browser to AAPC/AHIMA's official verify pages themselves, since
#     those pages are reCAPTCHA-protected and can't be checked by
#     unattended server code. Optional - the Live Verify button just shows
#     a clear "not configured" error without this. Sign up at
#     https://browserbase.com, create a project, and copy the API key from
#     Settings. BROWSERBASE_PROJECT_ID is optional - Browserbase can infer
#     the project from the API key.) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

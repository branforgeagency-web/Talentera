{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://talentera-1.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://talentera-1.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|favicon|logo|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
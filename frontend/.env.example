# Copy this file to frontend/.env and fill in real values before running the
# dev server or building for production.

# Backend API base URL. Defaults to "/api" (proxied by Vite in dev) if unset.
VITE_API_BASE_URL=/api

# MSG91 OTP Widget (login second factor for all four portals) - see the
# root README.md "Login OTP (MSG91 Widget)" section for setup steps.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
